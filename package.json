{
  "name": "aporta",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de moradia e guia da cidade para Benjamin Constant, no Alto Solimões",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "check": "pnpm --recursive check",
    "test:unit": "pnpm --recursive test:unit",
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
