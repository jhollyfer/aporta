#--------------------------------------------------------------------
# Node
#--------------------------------------------------------------------
NODE_ENV=development
PORT=3333
# In a container use `0.0.0.0`: `localhost` only accepts connections from inside
# the container itself, so the host proxy never reaches it.
HOST=localhost
# Process time zone. `UTC` in every environment: when absent, Node inherits the
# host time zone and the same query answers different dates depending on the
# machine. Converting to the reader's time zone is the presentation layer's job.
TZ=UTC

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
LOG_LEVEL=info
APP_KEY=
APP_SERVER_URL=http://${HOST}:${PORT}

# Reverse proxies whose `X-Forwarded-For` is trusted: addresses, CIDR ranges and
# the words `loopback`, `linklocal` and `uniquelocal`, comma separated. When
# absent only `loopback` applies: right with no proxy in front, and behind
# Coolify's Traefik **it must be declared**, otherwise `request.ip()` returns
# the proxy IP for everyone and the per-IP limits (sign-in, refresh) become one
# global bucket. Never `true`: the client would forge the header and pick the
# limit key. Use the proxy network, not the whole internet.
# TRUSTED_PROXIES=172.16.0.0/12

#--------------------------------------------------------------------
# Session
#--------------------------------------------------------------------
# The `Domain` of the session cookies. Empty in development, and that is right:
# cookies ignore the port, so `localhost:3333` and `localhost:3000` already share
# the same domain.
#
# In production, with the app and the API on different hosts, it is **required**,
# and the schema does not demand it because empty is the right value in
# development. Without it the cookie is host-only on the API host, and the
# frontend SSR - which calls the API on the first navigation - never receives
# it: every F5 on a private route goes back to the sign-in screen. The value is
# the smallest domain that covers both hosts.
# COOKIE_DOMAIN=.example.com

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
# Browser origins allowed to call this API, comma separated. In development the
# configuration allows everything and this variable is ignored; outside it,
# absent means an empty list, and an empty list refuses every cross-origin
# request. `*` is not an option: the API uses cookies, and the protocol refuses
# the wildcard when the request carries credentials.
# CORS_ORIGINS=https://app.example.com

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
# 5435 and not 5432: the default port is often taken by another Postgres on the
# same machine, and this project's `docker-compose.yml` publishes on 5435.
DATABASE_URL=postgres://aporta:aporta@localhost:5435/aporta
# TLS on the connection. **Absent means TLS off**: the connection goes out in
# clear text. It depends on where the database is, not on the environment: a
# database on the application's private network usually does not speak TLS
# (leave it absent or `false`); a managed database, outside it, requires `true`.
# DATABASE_SSL=false

#--------------------------------------------------------------------
# Storage
#--------------------------------------------------------------------
# Upload is presigned multipart: the binary goes from the browser straight to the
# bucket and never crosses this application. Multipart is an S3 API, so the
# destination is an S3-compatible bucket in every environment - MinIO in dev and
# in tests, and in production whatever STORAGE_ENDPOINT points to.
#
# Per-file ceiling, in bytes. Required: without it the application does not
# start. How much fits in an upload is the operator's decision, and a default in
# the code would be a ceiling nobody chose. Below, 1 GiB.
UPLOAD_MAX_SIZE=1073741824

# Credential, bucket and endpoint are required. Below, the local MinIO
# (`docker compose up -d`), with the console at http://localhost:9007 and the API
# on 9006 for the same reason as the database port (other house projects on the same
# machine take 5432-5434 and 9000-9005). The application signs in
# with a minimal-scope user that `minio-setup` creates; root only serves the
# setup and the console.
MINIO_ROOT_USER=aporta-root
MINIO_ROOT_PASSWORD=aporta-root-secret
STORAGE_KEY=aporta
STORAGE_SECRET=aporta-secret
STORAGE_BUCKET=aporta
STORAGE_ENDPOINT=http://localhost:9006
# MinIO only serves `endpoint/bucket/key`. In production (R2, S3, Spaces), remove.
STORAGE_FORCE_PATH_STYLE=true

# In production:
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  (or s3.<region>.amazonaws.com, etc.)
#
# The bucket is **private**: nothing in it is served by a public URL, and every
# read goes through a short-lived signed URL. The production bucket needs CORS
# open to the frontend origin, with PUT in the methods and `ETag` in
# ExposeHeaders - without the exposed ETag the client cannot confirm the parts
# and no multipart upload completes.
#
# The policy is in `infra/r2-cors.json`. It is not applied by deploy: paste it
# in the provider's panel or
#   aws s3api put-bucket-cors --bucket $STORAGE_BUCKET \
#     --cors-configuration file://infra/r2-cors.json \
#     --endpoint-url $STORAGE_ENDPOINT

#--------------------------------------------------------------------
# Seeding
#--------------------------------------------------------------------
# The first administrator, which `node ace db:seed` creates outside production.
# Without the password the seeder stops, on purpose: a password in the code
# would be a credential known to anyone who read the repository.
#
# The application starts without these: the seeder, run by hand, is what
# requires them.
SEED_OWNER_EMAIL=administrator@mail.com
SEED_OWNER_PASSWORD=