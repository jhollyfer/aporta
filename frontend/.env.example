# Endereço público do site, sem barra no fim: canônico, sitemap e og:url.
# Produção: https://aporta.maiyu.com.br
VITE_SITE_URL=http://localhost:3000

# Base da API AdonisJS, sem barra no fim. Obrigatória: o frontend lê anúncios,
# bairros e guia dela, e entra no bundle em tempo de build.
# Produção: https://api-aporta.maiyu.com.br
VITE_API_URL=http://localhost:3333

# Endereço da API visto pelo SSR (rede interna), só do servidor. Opcional: ausente,
# o servidor usa VITE_API_URL.
# SERVER_API_URL=http://api:3333
