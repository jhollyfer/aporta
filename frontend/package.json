{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-cycles": "node scripts/check-chunk-cycles.mjs",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write . && eslint --fix",
    "check": "pnpm lint && pnpm typecheck && prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@aporta/shared": "workspace:*",
